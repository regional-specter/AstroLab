{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrolab.local/schemas/clause_extraction.json",
  "title": "CUAD clause extraction payload",
  "type": "object",
  "required": ["clauses"],
  "properties": {
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_type", "exact_quote", "confidence", "statute_code"],
        "properties": {
          "clause_type": { "type": "string", "minLength": 1 },
          "exact_quote": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "statute_code": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
